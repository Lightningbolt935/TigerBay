<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ios/Runner/Info.plist
  MERGE these keys into your existing Info.plist generated by Flutter.
  Replace YOUR_REVERSED_CLIENT_ID with the value from GoogleService-Info.plist.
-->
<plist version="1.0">
<dict>

  <!-- ── App display name ──────────────────────────────────────────── -->
  <key>CFBundleDisplayName</key>
  <string>TigerBay International</string>

  <!-- ── URL Schemes for OAuth deep links ─────────────────────────── -->
  <key>CFBundleURLTypes</key>
  <array>

    <!-- Google Sign-In reversed client ID -->
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>YOUR_REVERSED_CLIENT_ID</string>
        <!-- e.g. com.googleusercontent.apps.123456789-abc -->
      </array>
    </dict>

    <!-- Custom app scheme for Supabase OAuth redirects -->
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>io.tigerbay.app</string>
      </array>
    </dict>

  </array>

  <!-- ── Apple Sign-In capability (also add in Xcode Signing & Capabilities) -->
  <!-- No plist key needed — enable via Xcode > Signing & Capabilities > + Sign In with Apple -->

  <!-- ── Camera and Photo Library (for avatar upload) ─────────────── -->
  <key>NSCameraUsageDescription</key>
  <string>TigerBay needs camera access to update your profile photo.</string>

  <key>NSPhotoLibraryUsageDescription</key>
  <string>TigerBay needs photo library access to update your profile photo.</string>

  <!-- ── Face ID (for biometric lock on wallet QR) ─────────────────── -->
  <key>NSFaceIDUsageDescription</key>
  <string>TigerBay uses Face ID to protect your loyalty wallet.</string>

  <!-- ── Allow arbitrary loads for dev (remove in production) ──────── -->
  <!-- <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict> -->

</dict>
</plist>

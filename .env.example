# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe (publishable key only in the app — secret key is server-side ONLY)
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Google OAuth
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
APP_SCHEME=io.tigerbay.app

# Twilio (server-side only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+447700000000

# Demo mode — accepts the master OTP (000000) in place of a real SMS code, and
# downgrades SMS delivery failures to non-blocking warnings.
# OFF unless explicitly set to true. NEVER set this in a published build.
#   flutter build web --release --dart-define=DEMO_MODE=true
# ci/vercel_build.sh never passes it, so Vercel builds are always demo-off.
DEMO_MODE=false
